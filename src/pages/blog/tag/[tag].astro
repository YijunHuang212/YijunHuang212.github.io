---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getAllTags, getPostsByTag } from '../../../lib/tags';

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const posts = await getPostsByTag(tag);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`标签：${tag}`} description={`标签 ${tag} 下的全部文章`}>
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <header class="mb-10">
      <h1 class="text-3xl font-bold sm:text-4xl">#{tag}</h1>
      <p class="mt-2 text-gray-600 dark:text-gray-400">共 {posts.length} 篇文章</p>
    </header>

    <div class="space-y-6">
      {posts.map((post) => <PostCard post={post} />)}
    </div>

    <div class="mt-12 text-center">
      <a
        href={`${base}blog/tag/`}
        class="text-sm text-blue-600 hover:underline dark:text-blue-400"
      >
        ← 返回全部标签
      </a>
    </div>
  </section>
</BaseLayout>
