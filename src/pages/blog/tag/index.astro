---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllTags } from '../../../lib/tags';

const tags = await getAllTags();
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="标签" description="全部文章标签">
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <header class="mb-10">
      <h1 class="text-3xl font-bold sm:text-4xl">标签</h1>
      <p class="mt-2 text-gray-600 dark:text-gray-400">共 {tags.length} 个标签</p>
    </header>

    <div class="flex flex-wrap gap-3">
      {
        tags.map(({ tag, count }) => (
          <a
            href={`${base}blog/tag/${encodeURIComponent(tag)}/`}
            class="group inline-flex items-center gap-2 rounded-full border border-gray-200 bg-white px-4 py-2 text-sm text-gray-700 transition hover:border-blue-300 hover:text-blue-600 dark:border-gray-800 dark:bg-gray-900 dark:text-gray-300 dark:hover:border-blue-700 dark:hover:text-blue-400"
          >
            #{tag}
            <span
              class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-500 transition group-hover:bg-blue-50 group-hover:text-blue-600 dark:bg-gray-800 dark:text-gray-400 dark:group-hover:bg-blue-950 dark:group-hover:text-blue-400"
            >
              {count}
            </span>
          </a>
        ))
      }
      {tags.length === 0 && <p class="text-gray-500">暂无标签。</p>}
    </div>
  </section>
</BaseLayout>
