---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Splash from '../components/Splash.astro';
import { getAllPosts } from '../lib/posts';
import { getAllCategories } from '../lib/categories';

const posts = await getAllPosts();
const latestPosts = posts.slice(0, 3);
const categories = await getAllCategories();
const base = import.meta.env.BASE_URL;
---

<BaseLayout>
  <section class="mx-auto max-w-3xl px-4 pb-16 sm:px-6">
    <div class="mb-12">
      <!-- 顶部横幅：poster 作为引言背景，横向占满页面 -->
      <div class="hero-banner mb-8">
        <img
          src={`${base}poster.jpg`}
          alt="海报背景"
          class="hero-banner__img"
          loading="eager"
        />
        <p class="hero-banner__quote">
          「Do not give ground to your desire.」
        </p>
      </div>

      <!-- 头像与署名 -->
      <div class="relative mb-6 flex flex-col items-center">
        <!-- 头像左上角副标题 -->
        <span
          class="absolute z-10 rounded-full bg-gray-900 px-3 py-1 text-xs font-semibold tracking-wide text-white shadow-md dark:bg-gray-100 dark:text-gray-900"
          style="left: calc(50% - 3.5rem); top: 0; transform: translate(-50%, -50%);"
        >
          About Me
        </span>
        <img
          src={`${base}pfp.jpg`}
          alt="Yijun Huang 的头像"
          class="h-28 w-28 rounded-full object-cover shadow-md ring-4 ring-gray-200 dark:ring-gray-700"
          width="112"
          height="112"
        />
        <p class="mt-4 text-lg font-semibold tracking-wide text-gray-800 dark:text-gray-200">Yijun Huang</p>
        <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">东南大学 · 信息工程</p>
      </div>

      <h1 class="text-3xl font-bold sm:text-4xl">欢迎来到我的博客</h1>
      <p class="mt-3 text-gray-600 dark:text-gray-400">
        记录前端学习与实践，目前共 {posts.length} 篇文章。
      </p>

      <!-- 文章导航：按合集/分类归类 -->
      <nav class="mt-5 flex flex-wrap items-center gap-2" aria-label="文章分类导航">
        <span class="text-sm text-gray-500 dark:text-gray-400">合集</span>
        {
          categories.map(({ category, count }) => (
            <a
              href={`${base}blog/category/${encodeURIComponent(category)}/`}
              class="inline-flex items-center gap-1.5 rounded-full bg-gray-100 px-3 py-1 text-sm text-gray-700 transition hover:bg-gray-900 hover:text-white dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-100 dark:hover:text-gray-900"
            >
              {category}
              <span class="text-xs text-gray-400 dark:text-gray-500">{count}</span>
            </a>
          ))
        }
      </nav>
    </div>

    <div class="space-y-6">
      {latestPosts.map((post) => <PostCard post={post} />)}
    </div>

    {
      posts.length > 3 && (
        <div class="mt-10 text-center">
          <a
            href={`${base}blog/`}
            class="inline-block rounded-lg bg-gray-900 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-gray-700 dark:bg-gray-100 dark:text-gray-900 dark:hover:bg-white"
          >
            查看全部文章 →
          </a>
        </div>
      )
    }
  </section>

  <!-- 进入博客的门面：点击后整幅插画上拉淡出 -->
  <Splash image="/felt-poster.png" />
</BaseLayout>

<style>
  /* 顶部海报横幅：横向占满页面（突破 max-w-3xl 容器），并上移到顶部栏背后 */
  .hero-banner {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100vw;
    margin-top: -4rem;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    /* 高度跟随海报本身比例（poster.jpg = 1054x486 ≈ 2.17:1），但大屏上限制最大高度避免过高 */
    aspect-ratio: 1054 / 486;
    max-height: 60vh;
  }
  /* 半透明遮罩：保证文字可读性 */
  .hero-banner::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.1);
  }
  .hero-banner__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* 裁切时保留画面上方，优先裁掉下方 */
    object-position: top;
  }
  .hero-banner__quote {
    position: relative;
    z-index: 1;
    margin: 0;
    padding: 0 1rem;
    text-align: center;
    font-family: Georgia, 'Songti SC', 'Times New Roman', serif;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.05em;
    color: #fff;
    text-shadow: 0 2px 8px rgb(0 0 0 / 0.6);
  }
  @media (min-width: 640px) {
    .hero-banner__quote {
      font-size: 1.875rem;
    }
  }
</style>
