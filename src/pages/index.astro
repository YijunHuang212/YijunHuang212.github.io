---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Splash from '../components/Splash.astro';
import { getAllPosts } from '../lib/posts';
import { getAllCategories } from '../lib/categories';

const posts = await getAllPosts();
const latestPosts = posts.slice(0, 3);
const categories = await getAllCategories();
const base = import.meta.env.BASE_URL;
---

<BaseLayout>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <div class="mb-12">
      <h1 class="text-3xl font-bold sm:text-4xl">欢迎来到我的博客</h1>
      <p class="mt-3 text-gray-600 dark:text-gray-400">
        记录前端学习与实践，目前共 {posts.length} 篇文章。
      </p>

      <!-- 文章导航：按合集/分类归类 -->
      <nav class="mt-5 flex flex-wrap items-center gap-2" aria-label="文章分类导航">
        <span class="text-sm text-gray-500 dark:text-gray-400">合集</span>
        {
          categories.map(({ category, count }) => (
            <a
              href={`${base}blog/category/${encodeURIComponent(category)}/`}
              class="inline-flex items-center gap-1.5 rounded-full bg-gray-100 px-3 py-1 text-sm text-gray-700 transition hover:bg-gray-900 hover:text-white dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-100 dark:hover:text-gray-900"
            >
              {category}
              <span class="text-xs text-gray-400 dark:text-gray-500">{count}</span>
            </a>
          ))
        }
      </nav>
    </div>

    <div class="space-y-6">
      {latestPosts.map((post) => <PostCard post={post} />)}
    </div>

    {
      posts.length > 3 && (
        <div class="mt-10 text-center">
          <a
            href={`${base}blog/`}
            class="inline-block rounded-lg bg-gray-900 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-gray-700 dark:bg-gray-100 dark:text-gray-900 dark:hover:bg-white"
          >
            查看全部文章 →
          </a>
        </div>
      )
    }
  </section>

  <!-- 进入博客的门面：点击后整幅插画上拉淡出 -->
  <Splash image="/felt-poster.png" />
</BaseLayout>
