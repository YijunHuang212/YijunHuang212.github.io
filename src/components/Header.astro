---
import ThemeToggle from './ThemeToggle.astro';

// BASE_URL 总是以 / 结尾（如 '/' 或 '/astro_blog/'），用它拼接链接可兼容 GitHub Pages base 路径
const base = import.meta.env.BASE_URL;

const navLinks = [
  { href: base, label: '首页' },
  { href: `${base}blog/`, label: '文章' },
  { href: `${base}blog/tag/`, label: '标签' },
];
---

<header class="relative z-40">
  <nav class="mx-auto flex h-16 max-w-3xl items-center justify-between px-4 sm:px-6">
    <a
      href={base}
      class="flex items-center gap-2 text-lg font-bold tracking-tight text-white [text-shadow:0_1px_6px_rgb(0_0_0/0.5)]"
    >
      <span>HYJ's Blog</span>
    </a>
    <div class="flex items-center gap-1 sm:gap-2">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-md px-3 py-1.5 text-sm font-medium text-white transition-colors [text-shadow:0_1px_4px_rgb(0_0_0/0.5)] hover:bg-black/20 hover:text-white"
          >
            {link.label}
          </a>
        ))
      }
      <ThemeToggle />
    </div>
  </nav>
</header>
