---
import ThemeToggle from './ThemeToggle.astro';

// BASE_URL 总是以 / 结尾（如 '/' 或 '/astro_blog/'），用它拼接链接可兼容 GitHub Pages base 路径
const base = import.meta.env.BASE_URL;

const navLinks = [
  { href: base, label: '首页' },
  { href: `${base}blog/`, label: '文章' },
  { href: `${base}blog/tag/`, label: '标签' },
];
---

<header
  class="sticky top-0 z-40 border-b border-gray-200/60 bg-white/80 backdrop-blur dark:border-gray-800 dark:bg-gray-950/80"
>
  <nav class="mx-auto flex h-16 max-w-3xl items-center justify-between px-4 sm:px-6">
    <a href={base} class="flex items-center gap-2 text-lg font-bold tracking-tight">
      <span class="text-xl">🚀</span>
      <span>我的博客</span>
    </a>
    <div class="flex items-center gap-1 sm:gap-2">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-md px-3 py-1.5 text-sm text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white"
          >
            {link.label}
          </a>
        ))
      }
      <ThemeToggle />
    </div>
  </nav>
</header>
