---
// Giscus 评论区组件（基于 GitHub Discussions）
// 使用方式：在 giscus.app 输入仓库名，复制生成的 data-category / data-category-id 填入 props
interface Props {
  /** GitHub 仓库，格式 "用户名/仓库名" */
  repo: string;
  /** giscus repo-id（GitHub API 的 node_id，R_ 开头） */
  repoId: string;
  /** Discussions 分类名，如 "General" 或 "Comments" */
  category: string;
  /** 分类 id（DIC_ 开头），giscus.app 生成 */
  categoryId: string;
  /** 评论与文章的映射方式，默认按页面路径匹配 */
  mapping?: 'pathname' | 'og:title' | 'specific' | 'number' | 'title';
  /** 界面语言，默认简体中文 */
  lang?: string;
}

const {
  repo,
  repoId,
  category,
  categoryId,
  mapping = 'pathname',
  lang = 'zh-CN',
} = Astro.props;
---

<section class="mx-auto mt-16 max-w-3xl px-4 sm:px-6" id="comments">
  <h2 class="mb-6 text-xl font-bold">💬 评论</h2>
  <!-- is:inline 让 giscus 的脚本原样输出到 HTML（不走 Astro 打包） -->
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo={repo}
    data-repo-id={repoId}
    data-category={category}
    data-category-id={categoryId}
    data-mapping={mapping}
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="1"
    data-input-position="top"
    data-theme="preferred_color_scheme"
    data-lang={lang}
    crossorigin="anonymous"
    async
  >
  </script>
</section>

<script>
  // 暗色模式同步：本站主题切换（<html> 的 .dark class）时，通知 giscus iframe 一起切换
  function syncGiscusTheme() {
    const frame = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
    if (!frame) return;
    const theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
    frame.contentWindow?.postMessage(
      { giscus: { setConfig: { theme } } },
      'https://giscus.app',
    );
  }

  // 1) giscus iframe 加载完成（giscus:ready）时主动同步一次，
  //    保证“系统亮色但本站手动切到暗色”这类首屏场景也被纠正
  window.addEventListener('message', (event) => {
    if (event.origin === 'https://giscus.app' && event.data?.giscus) {
      syncGiscusTheme();
    }
  });

  // 2) 用户点击本站主题切换按钮（.dark class 变化）时实时同步
  const observer = new MutationObserver(syncGiscusTheme);
  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class'],
  });
</script>
