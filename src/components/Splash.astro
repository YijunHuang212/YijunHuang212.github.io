---
interface Props {
  /** 门面插画路径（public/ 下） */
  image: string;
  /** 底部提示文字 */
  hint?: string;
}

const { image, hint = 'Enter My Planet' } = Astro.props;
const base = import.meta.env.BASE_URL;
const imageUrl = image.startsWith('http') ? image : `${base}${image.replace(/^\//, '')}`;
---

<div id="splash" class="splash" role="button" tabindex="0" aria-label="点击进入博客">
  <img src={imageUrl} alt="羊毛毡风格的小王子在给玫瑰浇水" class="splash__img" />
  <!-- 书名标题：置于右侧天空，横向排版，纵向居中偏上 -->
  <header class="splash__title">
    <h1 class="splash__title-main">HYJ's Blog</h1>
  </header>
  <!-- 左侧夜空竖排 tagline：两列英文 + 右侧中文书法 -->
  <p class="splash__tagline">
    <span class="splash__tagline-line">「True riches are found in</span>
    <span class="splash__tagline-line">the simplest things.」</span>
    <span class="splash__tagline-zh">真正的财富蕴藏在最简单的事物中。</span>
  </p>
  <div class="splash__hint">
    <span class="splash__hint-pill">
      <!-- 星球图标（左侧） -->
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4.5" />
        <ellipse cx="12" cy="12" rx="9.5" ry="3" transform="rotate(-18 12 12)" />
      </svg>
      <span>{hint}</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 5v14" />
        <path d="m19 12-7 7-7-7" />
      </svg>
    </span>
  </div>
</div>

<script>
  const SPLASH_KEY = 'felt-splash-seen';
  const splash = document.getElementById('splash');

  function leave() {
    if (!splash || splash.classList.contains('splash--leaving')) return;
    splash.classList.add('splash--leaving');
    // 上拉淡出过渡结束后移除 DOM
    setTimeout(() => splash.remove(), 700);
  }

  function markSeenAndLeave() {
    try {
      sessionStorage.setItem(SPLASH_KEY, '1');
    } catch {
      /* ignore */
    }
    leave();
  }

  // 同一会话（标签页）已点过 → 直接跳过门面，避免刷新后又弹出来
  if (sessionStorage.getItem(SPLASH_KEY)) {
    splash?.remove();
  } else {
    splash?.addEventListener('click', markSeenAndLeave);
    // 键盘可访问（回车 / 空格）
    splash?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        markSeenAndLeave();
      }
    });
  }
</script>

<style is:global>
  .splash {
    position: fixed;
    inset: 0;
    z-index: 50;
    cursor: pointer;
    background: #fdf3e7;
    transition:
      transform 0.65s ease-in-out,
      opacity 0.65s ease-in-out;
  }
  .splash__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
  }
  /* 书名标题：右侧天空，横向排版，纵向居中偏上 */
  .splash__title {
    position: absolute;
    right: 8%;
    top: 40%;
    transform: translateY(-50%);
    z-index: 1;
    animation: title-in 0.9s ease-out both;
  }
  .splash__title-main {
    margin: 0;
    font-family: Georgia, 'Songti SC', 'Times New Roman', serif;
    font-size: clamp(48px, 7.8vmin, 96px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: 0.18em;
    color: #f7f1e2;
    text-shadow:
      0 2px 6px rgb(0 0 0 / 0.45),
      0 6px 18px rgb(0 0 0 / 0.3);
  }
  /* 左侧夜空竖排 tagline：两列竖排（容器普通横排 flex，每列 span 竖排），两端「」 */
  .splash__tagline {
    position: absolute;
    left: 6%;
    top: 10%;
    margin: 0;
    z-index: 1;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 10px;
    font-family: Georgia, 'Songti SC', 'Times New Roman', serif;
    font-size: clamp(22px, 3.2vmin, 30px);
    color: #ebd9af;
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.45);
    animation: tagline-in 1.2s ease-out 0.3s both;
  }
  .splash__tagline-line {
    writing-mode: vertical-lr;
    line-height: 1.3;
    letter-spacing: 0.25em;
    white-space: nowrap;
  }
  /* 右侧中文竖排书法：汉字正立、从上往下写 */
  .splash__tagline-zh {
    margin-left: 28px;
    writing-mode: vertical-rl;
    text-orientation: upright;
    line-height: 1.35;
    letter-spacing: 0.08em;
    white-space: nowrap;
    font-family: '楷体', 'KaiTi', 'STKaiti', 'Kaiti SC', 'Songti SC', 'SimSun', serif;
  }
  .splash__hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: 1px;
    color: #fff;
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.5);
    animation: hint-bob 1.6s ease-in-out infinite;
  }
  /* 更醒目的胶囊提示：半透明底 + 毛玻璃 + 星球图标 */
  .splash__hint-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 11px 24px;
    border-radius: 999px;
    background: rgb(15 23 42 / 0.55);
    border: 1px solid rgb(255 255 255 / 0.35);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    box-shadow: 0 6px 22px rgb(0 0 0 / 0.3);
  }
  /* 上拉 + 淡出 */
  .splash--leaving {
    transform: translateY(-100%);
    opacity: 0;
  }

  @keyframes hint-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  @keyframes title-in {
    from {
      opacity: 0;
      transform: translateY(calc(-50% + 8px));
    }
    to {
      opacity: 1;
      transform: translateY(-50%);
    }
  }

  @keyframes tagline-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .splash {
      transition-duration: 0.01s;
    }
    .splash__hint {
      animation: none;
    }
    .splash__title {
      animation: none;
    }
    .splash__tagline {
      animation: none;
    }
  }
</style>
