---
import type { Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const base = import.meta.env.BASE_URL;
const postUrl = `${base}blog/${post.id}/`;

const formattedDate = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);
---

<article
  class="group rounded-xl border border-gray-200 bg-white p-5 transition hover:border-gray-300 hover:shadow-sm dark:border-gray-800 dark:bg-gray-900 dark:hover:border-gray-700"
>
  <a href={postUrl} class="block">
    <h2
      class="text-lg font-semibold text-gray-900 transition-colors group-hover:text-blue-600 dark:text-gray-100 dark:group-hover:text-blue-400"
    >
      {title}
    </h2>
    <p class="mt-2 line-clamp-2 text-sm text-gray-500 dark:text-gray-400">{description}</p>
    <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
      <time datetime={post.data.pubDate.toISOString()} class="text-gray-400 dark:text-gray-500">
        {formattedDate}
      </time>
      {
        tags.map((tag) => (
          <span
            class="rounded-full bg-gray-100 px-2 py-0.5 text-gray-600 dark:bg-gray-800 dark:text-gray-300"
          >
            {tag}
          </span>
        ))
      }
    </div>
  </a>
</article>
