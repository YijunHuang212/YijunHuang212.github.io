---
interface Props {
  tag: string;
  size?: 'sm' | 'md';
}

const { tag, size = 'sm' } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}blog/tag/${encodeURIComponent(tag)}/`;

const sizeClasses =
  size === 'md' ? 'px-4 py-2 text-sm' : 'px-2.5 py-0.5 text-xs';
---

<a
  href={href}
  class={`inline-flex items-center rounded-full bg-gray-100 font-medium text-gray-600 transition hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700 ${sizeClasses}`}
>
  #{tag}
</a>
